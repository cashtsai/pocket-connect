# Pocket bridge relay — exposes the local bridge (cc/codex/v2/hermes 三路) publicly.
# Managed standalone so it never disturbs the fed-console-studio tunnel.
tunnel: <TUNNEL-UUID>
credentials-file: /Users/you/.cloudflared/<TUNNEL-UUID>.json

ingress:
  - hostname: pocket.tsai.cash
    service: http://127.0.0.1:8081
  - service: http_status:404
