#!/usr/bin/env python3
"""Per-user installer/controller for the packaged Linux bridge."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

UNIT = "pocket-connect.service"
HOME = Path.home()
BASE = HOME / ".local/share/pocket-connect"
CONFIG = HOME / ".config/pocket-connect"
STATE = HOME / ".local/state/pocket-connect"
UNIT_FILE = HOME / ".config/systemd/user" / UNIT
CURRENT = BASE / "current"


def run(args, **kwargs):
    if str(args[0]) in ["systemctl", "journalctl"]:
        kwargs.setdefault("env", systemd_environment())
    return subprocess.run([str(a) for a in args], check=True, **kwargs)


def systemd_environment(runtime_dir=None):
    env = os.environ.copy()
    directory = Path(runtime_dir or f"/run/user/{os.geteuid()}")
    # Headless SSH/sudo sessions can omit XDG_RUNTIME_DIR even with linger active.
    if not env.get("XDG_RUNTIME_DIR") and directory.is_dir() and directory.stat().st_uid == os.geteuid():
        env["XDG_RUNTIME_DIR"] = str(directory)
        env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={directory}/bus")
    return env


def private_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def config():
    return json.loads((CONFIG / "settings.json").read_text())


def unit_quote(value):
    value = str(value)
    if any(c in value for c in "\n\r\0"):
        raise ValueError("Paths must not contain control characters")
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%") + '"'


def unit_text():
    launcher = BASE / "pocket-connect"
    return "\n".join([
        "[Unit]", "Description=Pocket Connect (per-user bridge)",
        "After=network-online.target", "StartLimitIntervalSec=300", "StartLimitBurst=5", "",
        "[Service]", "Type=simple", "UMask=0077",
        "WorkingDirectory=%h/.local/share/pocket-connect/current/bridge",
        f"ExecStart=/usr/bin/python3 {unit_quote(launcher)} run",
        "Restart=on-failure", "RestartSec=5", "TimeoutStopSec=15", "KillMode=control-group", "",
        "[Install]", "WantedBy=default.target", "",
    ])


def verify_package(root):
    manifest = json.loads((root / "manifest.json").read_text())
    if manifest.get("schema") != 1 or not manifest.get("files"):
        raise ValueError("Invalid package manifest")
    expected = set(manifest["files"])
    actual = {str(p.relative_to(root)) for p in root.rglob("*") if p.is_file()} - {"manifest.json"}
    if actual != expected:
        raise ValueError("Package contents differ from manifest")
    for name, digest in manifest["files"].items():
        p = root / name
        if p.is_symlink() or not p.resolve().is_relative_to(root.resolve()):
            raise ValueError("Unsafe package path")
        if hashlib.sha256(p.read_bytes()).hexdigest() != digest:
            raise ValueError(f"Package checksum failed: {name}")
    for name in ["bridge/bridge.py", "bridge/requirements.txt", "bridge/deploy/bridge-supervisor.sh"]:
        if name not in expected:
            raise ValueError(f"Incomplete package: {name}")
    return manifest


def systemd_ready():
    return shutil.which("systemctl") and subprocess.run(
        ["systemctl", "--user", "show-environment"], stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, env=systemd_environment()).returncode == 0


def check_platform():
    if sys.platform != "linux" or sys.version_info < (3, 10):
        raise ValueError("Requires Ubuntu 22.04+ / Debian 12+ and Python 3.10+. Windows: use WSL2.")
    if os.geteuid() == 0:
        raise ValueError("Run as your normal Linux user, NOT sudo/root. apt installs the package only.")
    release = {}
    for line in Path("/etc/os-release").read_text().splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            release[k] = v.strip('"')
    minimum = {"ubuntu": 22, "debian": 12}.get(release.get("ID"))
    if minimum is None or int(release.get("VERSION_ID", "0").split(".")[0]) < minimum:
        raise ValueError("This preview supports Ubuntu 22.04+ and Debian 12+ only")
    import ensurepip  # noqa: F401: fail before touching an existing install


def health(settings, authenticated=False):
    path = "/capabilities" if authenticated else "/health"
    headers = {}
    if authenticated:
        headers["Authorization"] = "Bearer " + (CONFIG / "bridge-token").read_text().strip()
    req = urllib.request.Request(f"http://127.0.0.1:{settings['port']}{path}", headers=headers)
    with urllib.request.urlopen(req, timeout=3) as response:
        return json.load(response)


def switch(target):
    link = BASE / "current.next"
    link.unlink(missing_ok=True)
    link.symlink_to(target)
    os.replace(link, CURRENT)


def install(args):
    check_platform()
    root = Path(args.package_dir).resolve() if args.package_dir else Path(__file__).resolve().parent
    manifest = verify_package(root)
    if not args.no_start and not systemd_ready():
        raise ValueError("User systemd is unavailable. In WSL enable systemd, restart WSL yourself, then retry. See README.")
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (BASE / "install.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        settings_path = CONFIG / "settings.json"
        old_settings = settings_path.read_text() if settings_path.exists() else None
        settings = json.loads(old_settings) if old_settings else {"port": args.port, "bind": "127.0.0.1"}
        if args.lan:
            settings["bind"] = "0.0.0.0"
        previous = CURRENT.resolve() if CURRENT.is_symlink() else None
        if previous is None and UNIT_FILE.exists():
            raise ValueError("An unmanaged pocket-connect.service already exists; refusing to overwrite it")
        if CURRENT.exists() and not CURRENT.is_symlink():
            raise ValueError("Refusing to overwrite an unmanaged install")
        if previous is None:
            with socket.socket() as s:
                s.bind(("0.0.0.0", settings["port"]))
        releases = BASE / "releases"
        releases.mkdir(exist_ok=True)
        target = Path(tempfile.mkdtemp(prefix=manifest["version"] + "-", dir=releases))
        try:
            shutil.copytree(root / "bridge", target / "bridge")
            shutil.copy2(root / "manifest.json", target / "manifest.json")
            run([sys.executable, "-m", "venv", target / "venv"])
            run([target / "venv/bin/python", "-m", "pip", "install", "--disable-pip-version-check", "-r", target / "bridge/requirements.txt"])
            run([target / "venv/bin/python", "-m", "compileall", "-q", target / "bridge"])
        except Exception:
            shutil.rmtree(target)
            raise
        CONFIG.mkdir(parents=True, exist_ok=True, mode=0o700)
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        for name in ["bridge-token", "pair-boot-code"]:
            if not (CONFIG / name).exists():
                private_write(CONFIG / name, secrets.token_urlsafe(36) + "\n")
            os.chmod(CONFIG / name, 0o600)
        settings["version"] = manifest["version"]
        # Preserve shell-selected tool paths (including nvm) for the user service.
        settings["path"] = os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin")
        old_unit = UNIT_FILE.read_text() if UNIT_FILE.exists() else None
        old_launcher = (BASE / "pocket-connect").read_bytes() if (BASE / "pocket-connect").exists() else None
        try:
            private_write(settings_path, json.dumps(settings, indent=2) + "\n")
            shutil.copy2(root / "pocket-connect", BASE / "pocket-connect")
            os.chmod(BASE / "pocket-connect", 0o700)
            private_write(UNIT_FILE, unit_text())
            switch(target)
            if args.no_start:
                print("Installed without starting. Run: pocket-connect start")
                return
            run(["systemctl", "--user", "daemon-reload"])
            run(["systemctl", "--user", "enable", UNIT])
            run(["systemctl", "--user", "restart", UNIT])
            for attempt in range(30):
                try:
                    health(settings, authenticated=True)
                    break
                except (OSError, ValueError, urllib.error.URLError):
                    if attempt == 29:
                        raise ValueError("Bridge did not pass authenticated readiness")
                    time.sleep(1)
        except Exception:
            if not args.no_start:
                subprocess.run(["systemctl", "--user", "stop", UNIT], check=False, env=systemd_environment())
            for path, old_content in [(settings_path, old_settings), (UNIT_FILE, old_unit)]:
                if old_content is None:
                    path.unlink(missing_ok=True)
                else:
                    private_write(path, old_content)
            if old_launcher is None:
                (BASE / "pocket-connect").unlink(missing_ok=True)
            else:
                (BASE / "pocket-connect").write_bytes(old_launcher)
            if previous:
                switch(previous)
                if not args.no_start:
                    run(["systemctl", "--user", "daemon-reload"])
                    run(["systemctl", "--user", "start", UNIT])
                print("Previous installation restored; user data and tokens retained.", file=sys.stderr)
            else:
                if not args.no_start:
                    subprocess.run(["systemctl", "--user", "disable", UNIT], check=False, env=systemd_environment())
                    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False, env=systemd_environment())
                CURRENT.unlink(missing_ok=True)
            shutil.rmtree(target)
            raise
        print("Pocket Connect is ready. Run: pocket-connect pair")
        if settings["bind"] == "127.0.0.1":
            print("Local-only by default. For phone access use Tailscale Serve or explicitly reinstall with --lan on a trusted LAN.")
        print("Login autostart enabled. For boot without login: sudo loginctl enable-linger " + os.environ.get("USER", "<user>"))


def runtime_env(settings):
    env = os.environ.copy()
    env.update({
        "BRIDGE_TOKEN": (CONFIG / "bridge-token").read_text().strip(),
        "PAIR_BOOT_CODE_FILE": str(CONFIG / "pair-boot-code"),
        "POCKET_BRIDGE_PORT": str(settings["port"]),
        "POCKET_CONSOLE_ENABLED": "1",
        "POCKET_CONSOLE_ENTRY_MODE": "relay",
        "POCKET_CONSOLE_QR_LOGIN": "0",
        "POCKET_CONSOLE_REMOTE_FILE_ROOTS": "",
        "POCKET_AGENT_LOGIN_IN_APP": "1",
        "CCSESS_HOOK_URL": f"http://127.0.0.1:{settings['port']}/ccsessions/_hook",
        "POCKET_TUNNEL_URL_FILE": str(CONFIG / "tunnel-url"),
        "POCKET_BRIDGE_CRASH_STATE_DIR": str(STATE),
        "POCKET_BRIDGE_CRASH_LOG": str(STATE / "crash-loop.log"),
        "PATH": str(HOME / ".local/bin") + ":" + settings.get("path", "/usr/local/bin:/usr/bin:/bin"),
    })
    return env


def local_entry_url(settings, console=False):
    code = (CONFIG / "pair-boot-code").read_text().strip()
    route = "/console" if console else "/pair/qr"
    return f"http://127.0.0.1:{settings['port']}{route}?boot={urllib.parse.quote(code)}"


def pairing_link(settings):
    url = local_entry_url(settings).replace("/pair/qr?", "/pair/qr.json?") + "&ttl=900"
    with urllib.request.urlopen(url, timeout=15) as response:
        data = json.load(response)
    payload = data.get("payload", "")
    if not data.get("ok") or not payload.startswith("pocket://pair?"):
        raise ValueError("No pairing route. Configure private Tailscale Serve or explicitly opt into trusted LAN access first.")
    return payload


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    setup = sub.add_parser("install")
    setup.add_argument("--package-dir")
    setup.add_argument("--no-start", action="store_true")
    setup.add_argument("--lan", action="store_true", help="Explicitly allow LAN access (no firewall changes)")
    setup.add_argument("--port", type=int, default=8081)
    sub.add_parser("run")
    sub.add_parser("keepalive")
    sub.add_parser("start")
    sub.add_parser("stop")
    sub.add_parser("status")
    sub.add_parser("doctor")
    sub.add_parser("logs")
    pair = sub.add_parser("pair")
    pair_output = pair.add_mutually_exclusive_group()
    pair_output.add_argument("--url", action="store_true", help="Print private pairing URL for local browser handoff only")
    pair_output.add_argument("--link", action="store_true", help="Print a private 15-minute single-use phone pairing link (headless hosts)")
    console = sub.add_parser("console")
    console.add_argument("--url", action="store_true", help="Print private local Console URL for browser handoff only")
    remove = sub.add_parser("uninstall")
    remove.add_argument("--yes", action="store_true")
    args = parser.parse_args()
    if args.command == "install":
        if not 1024 <= args.port <= 65535:
            raise ValueError("Port must be between 1024 and 65535")
        install(args)
    elif args.command == "doctor":
        print(json.dumps({"platform": sys.platform, "python": sys.version.split()[0],
                          "installed": CURRENT.is_symlink(), "user_systemd": bool(systemd_ready()),
                          "tools": {n: bool(shutil.which(n)) for n in ["claude", "codex", "tmux", "tailscale"]}}, indent=2))
    elif args.command in ["start", "stop"]:
        run(["systemctl", "--user", "daemon-reload"])
        run(["systemctl", "--user", args.command, UNIT])
    elif args.command == "keepalive":
        with (BASE / "keepalive.lock").open("w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
            run(["systemctl", "--user", "start", UNIT])
            # A foreground WSL command keeps the distro alive; systemd alone does not.
            while UNIT_FILE.exists():
                time.sleep(10)
    elif args.command == "logs":
        run(["journalctl", "--user", "-u", UNIT, "-n", "60", "--no-pager"])
    elif args.command == "status":
        settings = config()
        health(settings, authenticated=True)
        print("Bridge authenticated health OK; model sign-in and phone reachability must be checked separately.")
    elif args.command in ["pair", "console"]:
        settings = config()
        health(settings, authenticated=True)
        if args.command == "pair" and args.link:
            print(pairing_link(settings))
            return
        url = local_entry_url(settings, console=args.command == "console")
        if args.url:
            print(url)
        else:
            import webbrowser
            if not webbrowser.open(url):
                raise ValueError("No desktop browser. Use an SSH local port forward and pair --url privately.")
    elif args.command == "run":
        settings = config()
        os.chdir(CURRENT / "bridge")
        argv = ["/bin/bash", str(CURRENT / "bridge/deploy/bridge-supervisor.sh"),
                str(CURRENT / "venv/bin/python"), "-m", "uvicorn", "bridge:app",
                "--host", settings["bind"], "--port", str(settings["port"]),
                "--timeout-graceful-shutdown", "3", "--no-access-log"]
        os.execve(argv[0], argv, runtime_env(settings))
    elif args.command == "uninstall":
        if not args.yes:
            raise ValueError("Use uninstall --yes to remove this service. Config, tokens, provider logins and history are retained.")
        run(["systemctl", "--user", "disable", "--now", UNIT])
        UNIT_FILE.unlink(missing_ok=True)
        run(["systemctl", "--user", "daemon-reload"])
        print("Service removed. User data retained. Remove the OS package separately with apt remove pocket-connect.")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError, urllib.error.URLError) as exc:
        print(f"Pocket Connect: {exc}", file=sys.stderr)
        sys.exit(1)
