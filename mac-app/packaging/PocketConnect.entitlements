<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sign in with Apple. Requires a Team-ID-backed App ID that has the
       "Sign in with Apple" capability enabled, plus a provisioning profile that
       matches CFBundleIdentifier (com.pocketagent.desktop). Ad-hoc signing will
       embed this entitlement but Apple will NOT return a usable identityToken
       without the real Team ID + profile — see README "Sign in with Apple". -->
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>

  <!-- CloudKit discovery layer (M2a). Same deal as applesignin: embedding the
       keys costs nothing under ad-hoc signing — the app runtime-checks its own
       signature (CloudGate) and silently disables CloudKit when the container
       entitlement isn't actually authorized. A Development-signed build with a
       provisioning profile whose App ID carries the iCloud capability is what
       makes this live (Q1=B: development signing first, Developer ID stays on
       the M4 schedule). -->
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array>
    <string>iCloud.com.pocketagent</string>
  </array>
  <key>com.apple.developer.icloud-services</key>
  <array>
    <string>CloudKit</string>
  </array>
  <!-- Silent push for the PocketZone CKSubscription; 30 s polling remains the
       guaranteed fallback when push isn't available. -->
  <key>com.apple.developer.aps-environment</key>
  <string>development</string>
</dict>
</plist>
