# Pocket 公開發佈（Developer ID + 公證）憑證設定範本。
#
# 用法：填好後複製到家目錄（不要放進 git！）：
#   cp packaging/pocket-release.env.example ~/.pocket-release.env
#   # 編輯 ~/.pocket-release.env 填入下面的值
#   NOTARIZE=1 ./packaging/build_dmg.sh
#
# 前置（只有善彰本人能做，一次性）：
#   1. https://developer.apple.com/account/resources/certificates/list
#      → 新增憑證 → 選「Developer ID Application」→ 依指示用鑰匙圈產 CSR → 下載 → 雙擊裝進鑰匙圈。
#   2. 憑證確切名稱：`security find-identity -v -p codesigning` 找那條 "Developer ID Application: ...".
#   3. 匯出 .p12 備份：`security export -k login.keychain-db -t identities -f pkcs12 -P <密碼> -o out.p12`
#      （若 GUI 匯出時「輸出項目」格式選單沒有 .p12 選項，通常是點到 System.keychain 那份
#      而非 login.keychain-db 那份——改用上面這行 CLI 指令繞過，login keychain 那份一定有私鑰。）

# codesign 用的憑證名稱（跑 security find-identity 取確切字串）
SIGN_IDENTITY="Developer ID Application: 你的名字 (4F8B93R3SH)"

# 團隊 ID（預設就是這個，一般不用改）
TEAM_ID="4F8B93R3SH"

# 公證認證 — 二選一，A 優先（不用再單獨產生 App 專用密碼）：

# Path A（建議）：沿用既有 App Store Connect API key（asc.py 上傳 TestFlight 用的同一組）
ASC_KEY_ID="7YB9Q2WYSA"
ASC_ISSUER_ID="3fcd9490-6ab5-4824-893c-12cc4b435b3b"
ASC_KEY_PATH="~/.appstoreconnect/private_keys/AuthKey_7YB9Q2WYSA.p8"

# Path B（備援）：Apple ID + App 專用密碼
#   App 專用密碼：https://account.apple.com → 登入與安全 → App 專用密碼 → 產生一組。
# APPLE_ID="you@apple.id"
# APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
